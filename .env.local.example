# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signed session cookies (console + survey list) — generate with `openssl rand -base64 32`
SESSION_SECRET=your-random-32-byte-secret

# Resend (https://resend.com) — the 6-digit survey verification code, and
# the bulk campaigns sent from /console/campaigns. Free tier covers 3,000
# emails/month; a 361-person campaign is one-eighth of that.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="sydHustle <noreply@sydhustle.com>"

# Campaign mail, kept apart from transactional mail on purpose: if a
# marketing send ever damages this address's reputation, verification codes
# still arrive. Optional — EMAIL_FROM is used when it's unset.
EMAIL_MARKETING_FROM="sydHustle <hello@sydhustle.com>"
# Where a reply to a campaign goes. Campaigns invite replies, so this should
# be an address a person actually reads.
EMAIL_REPLY_TO=hello@sydhustle.com
# Printed in every campaign footer. A physical postal address is required on
# commercial email by CAN-SPAM and its equivalents — not optional in law,
# even though it is optional here (a default ships in lib/email/template.ts).
EMAIL_POSTAL_ADDRESS="sydHustle, Ado-Ekiti, Ekiti State, Nigeria"
# Signing secret for the Resend webhook that feeds delivery, open, bounce
# and complaint events into the campaign dashboard. Create the endpoint in
# Resend > Webhooks pointing at https://sydhustle.com/api/email/webhook and
# paste its `whsec_...` secret here. Without it the endpoint refuses every
# delivery and campaigns simply stop reporting at "sent".
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# The OWNER account. Signs in to the console (sydhustle.com/console) with
# every tab, and is the only account that can open /admin to create roles and
# invite staff. Deliberately not a database row: it can't be demoted, deleted
# or locked out through the screen that administers everyone else, and an
# empty staff table is still a working console. Staff accounts have their own
# passwords, chosen by them and stored hashed — they never appear here.
CONSOLE_EMAIL=hello@sydhustle.com
CONSOLE_PASSWORD=choose-a-strong-password

# Lets the console ask the `disclose-identity` edge function to decrypt a
# retained NIMC record. Must match that function's CONSOLE_DISCLOSURE_SECRET
# secret exactly. The AES key itself stays in the function and never comes
# here — that separation is the point, so don't "simplify" it by moving
# IDENTITY_RECORD_KEY into this file.
#   openssl rand -base64 32
CONSOLE_DISCLOSURE_SECRET=your-base64-32-byte-secret

# Cloudflare R2 — promo banner artwork (app/console/api/promo-art).
# Banners are the app's highest-traffic images, a few objects downloaded by
# every user on the home and discover screens, so they live on R2 where
# egress is free rather than on Supabase Storage where it is metered.
# The same bucket the mobile app writes avatars and skill photos into; this
# route only ever writes the `promo/` prefix.
# Create the token in Cloudflare under R2 > API tokens, scoped to Object
# Read & Write on this ONE bucket. A separate token from the app's is worth
# it so either can be revoked without taking the other down.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sydhustle-media
R2_PUBLIC_BASE_URL=https://cdn.sydhustle.com

# Keep Server Action IDs stable across builds (avoids "Server Action was not
# found" after deploys without Vercel Pro Skew Protection). Generate with:
#   openssl rand -base64 32
# Must be present at BUILD time on Vercel (Production + Preview).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-32-byte-key
