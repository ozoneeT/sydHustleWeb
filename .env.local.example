# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Moderator/admin dashboard sessions — generate with `openssl rand -base64 32`
SESSION_SECRET=your-random-32-byte-secret

# Resend (https://resend.com) — used to email the 6-digit survey
# verification code. Free tier covers 3,000 emails/month at no cost.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="sydHustle <noreply@sydhustle.com>"
